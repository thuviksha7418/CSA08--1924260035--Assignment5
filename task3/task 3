import sqlite3

readings = [
    ("Adyar", "2026-10-01", 48.0),
    ("Guindy", "2026-10-01", 95.0),
    ("Guindy", "2026-10-03", 121.0),
    ("Adyar", "2026-10-04", 60.0)
]

con = sqlite3.connect(":memory:")

con.execute("""
CREATE TABLE aq (
    station TEXT,
    day TEXT,
    pm25 REAL
)
""")

con.executemany(
    "INSERT INTO aq VALUES (?, ?, ?)",
    readings
)

con.commit()

# Query 1: Adyar average PM2.5
q1 = con.execute("""
SELECT AVG(pm25)
FROM aq
WHERE station = ?
AND day BETWEEN ? AND ?
""", ("Adyar", "2026-10-01", "2026-10-31")).fetchone()[0]

# Query 2: Station with highest PM2.5
q2 = con.execute("""
SELECT station, MAX(pm25)
FROM aq
GROUP BY station
ORDER BY MAX(pm25) DESC
LIMIT 1
""").fetchone()

# Query 3: Average PM2.5 on October 1
q3 = con.execute("""
SELECT AVG(pm25)
FROM aq
WHERE day = ?
""", ("2026-10-01",)).fetchone()[0]

print("Adyar Average:", q1)
print("Highest Station:", q2)
print("October 1 Average:", q3)

con.close()
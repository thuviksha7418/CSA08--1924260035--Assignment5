POSITIVE = {
    "good", "clean", "fast", "helpful", "improved"
}

NEGATIVE = {
    "bad", "dirty", "slow", "rude", "smoke", "broken"
}

NEGATORS = {
    "not", "never", "no"
}


def score(text):

    words = (
        text.lower()
        .replace(".", " ")
        .replace(",", " ")
        .split()
    )

    total = 0

    for i, word in enumerate(words):

        value = (
            1 if word in POSITIVE
            else -1 if word in NEGATIVE
            else 0
        )

        if i > 0 and words[i - 1] in NEGATORS:
            value *= -1

        total += value

    return total


def label(text):

    s = score(text)

    if s > 0:
        return "positive"

    elif s < 0:
        return "negative"

    else:
        return "neutral"


complaints = [
    "Roads are clean and the bus was fast.",
    "Smoke from the factory, air is bad.",
    "The staff were not helpful.",
    "Not bad, service improved."
]

for complaint in complaints:

    print(
        label(complaint),
        "|",
        complaint
    )
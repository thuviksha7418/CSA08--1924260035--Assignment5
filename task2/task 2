import csv
import io

RAW = """station,date,pm25
Adyar,2026-10-01,48
Adyar,2026-10-02,NA
Adyar,2026-10-03,
Guindy,2026-10-01,95
Guindy,2026-10-02,-5
Guindy,2026-10-03,121
Adyar,2026-10-04,1200
"""

def load_clean(text):
    rows = []

    reader = csv.DictReader(io.StringIO(text))

    required = {"station", "date", "pm25"}

    if not required.issubset(reader.fieldnames or []):
        raise ValueError("Required CSV column is missing")

    for row in reader:
        raw = (row.get("pm25") or "").strip()

        if raw.upper() in ("", "NA"):
            continue

        try:
            value = float(raw)
        except ValueError:
            continue

        if value < 0 or value > 999:
            continue

        rows.append((
            row["station"].strip(),
            row["date"].strip(),
            value
        ))

    return rows


def min_max(values):
    if not values:
        return []

    low = min(values)
    high = max(values)

    if high == low:
        return [0.0 for v in values]

    return [
        round((v - low) / (high - low), 3)
        for v in values
    ]


clean = load_clean(RAW)

print("Cleaned Data:")
print(clean)

values = [pm for _, _, pm in clean]

print("Normalised Values:")
print(min_max(values))